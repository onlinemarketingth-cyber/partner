APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Omise (Opn Payments) keys are intentionally NOT here — see ADR-027.
# One Omise account per COMPANY (money lands in the selling company's own
# account, not the platform's), so credentials are per-tenant and live
# encrypted in `company_payment_gateway_settings`, entered through the Admin
# UI. A single pair in .env would route every tenant's revenue into one
# account. Do not re-add OMISE_SECRET_KEY here.

# ---------------------------------------------------------------------
# SPA origins — REQUIRED, and required in production too.
#
# SECURITY AUDIT 2026-08-21 (V14): config/cors.php used to fall back to
# the hardcoded local dev origins when these were unset, in EVERY
# environment. It no longer does — outside APP_ENV=local the allowlist is
# exactly what these two variables say and nothing else. An unset value
# now means "no browser origin may call this API with credentials", which
# fails loudly at the first login instead of quietly trusting localhost.
#
# Keep SANCTUM_STATEFUL_DOMAINS in step: it takes host:port, no scheme,
# and Sanctum's own check is not pattern-based.
FRONTEND_URL=http://agent.localhost:5178
ADMIN_FRONTEND_URL=http://admin.localhost:5179
SANCTUM_STATEFUL_DOMAINS=agent.localhost:5178,admin.localhost:5179
