# SPA fallback for Vue Router's createWebHistory (HTML5 pushState) mode.
# Same reasoning as frontend/public/.htaccess — see that file's comment.
# admin.partner.syncvision.io has its own dedicated document root
# (public_html/admin), so RewriteBase "/" is correct here too.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # -------------------------------------------------------------------
  # SECURITY AUDIT 2026-08-21 — this console answers on ONE host only.
  #
  # This folder is the document root of admin.partner.syncvision.io AND a
  # subfolder of the agent portal's document root, because that is how the
  # subdomain was pointed at it. So https://partner.syncvision.io/admin/
  # serves this application in full — confirmed on production, and it is
  # the real console, not a broken shell: both URLs return
  # <title>Sync Vision Admin</title>.
  #
  # WHY THE RULE IS HERE AND NOT (only) IN THE PARENT
  # The equivalent rule was added to the agent portal's .htaccess first
  # and deployed, and /admin/ still answered 200. A .htaccess in a PARENT
  # directory is not reliably consulted for a request that resolves into a
  # subdirectory holding its own .htaccess — how much of the parent's
  # rewrite context survives varies by server, and this host runs
  # LiteSpeed rather than Apache. The file sitting next to the resource is
  # always read. So the rule belongs next to the resource.
  #
  # The parent's copy is kept as a second layer rather than removed: two
  # cheap rules, and the one that fires depends on a server behaviour we
  # do not control.
  #
  # KEYED ON THE HOST, WHICH IS WHAT MAKES IT SAFE TO PUT HERE.
  # This is the admin console's OWN .htaccess — a bare `RewriteRule ^`
  # deny would 403 the real console. The condition means it can only ever
  # fire for a request that arrived at partner.syncvision.io, i.e. the
  # wrong door. Requests to admin.partner.syncvision.io never match it.
  # After TASK-231 took production down through this exact class of file,
  # a rule in here has to fail safe by construction, not by review.
  # -------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^partner\.syncvision\.io$ [NC]
  RewriteRule ^ - [F,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ---------------------------------------------------------------------
# SECURITY AUDIT 2026-08-21 (V10) — response security headers.
#
# Before this the whole stack set NONE of these, which meant the admin console
# could be loaded inside an <iframe> on any site in the world. That is
# clickjacking: the attacker's page overlays its own invisible UI on top
# of a logged-in session and harvests clicks that land on real buttons.
#
# ⚠️ THIS FILE HAS TAKEN PRODUCTION DOWN BEFORE (TASK-231) — it went out
# mode 600, LiteSpeed could not read it, and every deep link 404'd. The
# cause was the file's PERMISSIONS, not its contents, and deploy.sh now
# rsyncs with --chmod=D755,F644. Verify after the first deploy that a
# deep link still loads AND that the headers are present:
#     curl -sI https://<host>/login | grep -i 'x-frame\|x-content\|referrer'
#
# Wrapped in IfModule so that a server without mod_headers ignores the
# block instead of throwing a 500 on every request.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# A FULL Content-Security-Policy is deliberately NOT enabled here yet.
#
# A content CSP does not warn when it is wrong — it white-screens the
# app — and the only honest way to tune one is to load every screen in a
# real browser and read the console. That has not been done, so shipping
# one would be trading a clickjacking risk for an outage risk.
#
# The starting point below is believed correct for this app (own bundle,
# API origin, YouTube embeds, blob: for pdf.js workers and object URLs).
# Enable it on a STAGING subdomain first, click through every screen with
# devtools open, then move it into the block above.
#
# Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.partner.syncvision.io; media-src 'self' blob: https://api.partner.syncvision.io; connect-src 'self' https://api.partner.syncvision.io; worker-src 'self' blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

# ---------------------------------------------------------------------
# index.html MUST NOT BE CACHED — re-added 2026-08-21, deliberately.
#
# ── THE FAILURE IT PREVENTS ──
#
# Vite gives every JS chunk a content hash, and `rsync --delete` removes
# the previous deploy's chunks. A browser holding a cached index.html from
# the last deploy therefore asks for hashes that no longer exist. The SPA
# fallback below rewrites those misses to index.html, so the browser
# receives HTML where it expected a module and refuses it:
#
#   Failed to load module script: Expected a JavaScript-or-Wasm module
#   script but the server responded with a MIME type of "text/html"
#
# The app then white-screens for that user, and only for returning users —
# a fresh visitor is fine, which is what makes it so easy to dismiss as
# "works on my machine". Seen on production on 2026-08-21.
#
# ── WHY THIS IS BACK AFTER BEING REVERTED ──
#
# TASK-229 added exactly this and TASK-231 reverted it during an outage,
# because the site was 404ing and this was the newest change. It was not
# the cause: .htaccess had reached the server as mode 600 and LiteSpeed
# could not read the file AT ALL, so every rule in it was inert — this one
# included. deploy.sh now forces file modes on upload (and, since
# 2026-08-21, over SSH where rsync has no --chmod), so the condition that
# caused that outage cannot recur silently.
#
# `no-cache` is NOT "do not store" — the browser keeps the copy and simply
# revalidates before using it. A 304 costs one small round trip; a
# white screen costs the visit.
#
# Hashed assets under /assets/ are deliberately left alone: they are
# immutable by construction and already cache well.
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
