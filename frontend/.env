# Bug fix (2026-08-02) — was http://localhost:8010. The Sanctum session
# cookie is scoped to whichever HOSTNAME this app's requests hit, not to
# this app's own origin — so as long as both frontends called the same
# "localhost:8010", they shared ONE login identity in the same browser
# no matter what port each app's own page ran on. Routing this app's API
# calls through its own hostname (agent.localhost) — same backend
# process, same port 8010, just a different Host header — gives it a
# genuinely separate session cookie from the Admin app (which now uses
# admin.localhost). Do not point this back at bare "localhost".
VITE_API_BASE_URL=http://agent.localhost:8010
# Admin app (ADR-003) — used only for the "Admin console" external link
# in TopNavigation.vue, shown to company_admin/super_admin users.
VITE_ADMIN_APP_URL=http://admin.localhost:5179
