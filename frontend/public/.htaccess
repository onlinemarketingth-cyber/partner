# SPA fallback for Vue Router's createWebHistory (HTML5 pushState) mode.
#
# Without this, a hard refresh or a direct link/bookmark to any deep
# route (e.g. /clients/123, /login?redirect=/) sends a REAL HTTP
# request to the server for that exact path. There's no such file on
# disk (the route only exists inside the Vue app's own JS router), so
# Apache/LiteSpeed 404s before the SPA ever gets a chance to boot and
# handle the route client-side. This rewrites any request that isn't a
# real file or directory back to index.html, letting the SPA take over.
#
# Vite copies everything in public/ verbatim into dist/ on build, so
# this ships automatically with every `npm run deploy`.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # -------------------------------------------------------------------
  # SECURITY AUDIT 2026-08-21 — the admin console must not answer on THIS
  # host. Confirmed by curl on production: partner.syncvision.io/admin/
  # returned 200.
  #
  # WHY IT HAPPENS: the admin build is deployed INSIDE this document root
  # (deploy.sh: FRONTEND_ADMIN_REMOTE_PATH = <this dir>/admin) because
  # admin.partner.syncvision.io's document root is that subfolder. One
  # folder, two ways in. The SPA fallback below cannot catch it either:
  # /admin is a REAL directory, so `!-d` is false and the request never
  # reaches the rewrite.
  #
  # WHY IT MATTERS: it puts the admin console on the agent portal's
  # origin — the origin that lets strangers self-register, that hosts the
  # public product-share page, and that therefore carries the larger XSS
  # surface of the two. Every origin-based boundary we have (CORS
  # allowlist, the planned session split, frame-ancestors) is stated in
  # terms of "which host is this", and this quietly makes one host two
  # things.
  #
  # KEYED ON THE HOST, NOT THE PATH, AND THAT IS THE WHOLE POINT.
  # A bare `RewriteRule ^admin` here would be a live grenade: if this
  # server ever applies a parent .htaccess to the subdomain whose docroot
  # is that same folder, the rule would 403 the real admin console into
  # oblivion. The condition means the rule can only ever fire for a
  # request that literally arrived at partner.syncvision.io — so the
  # worst case is that it does nothing, never that it takes the admin
  # console down. Given TASK-231 (this file, mode 600, production 404s
  # for an afternoon), a rule in here has to fail safe by construction.
  # -------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^partner\.syncvision\.io$ [NC]
  RewriteRule ^admin(/|$) - [F,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ---------------------------------------------------------------------
# SECURITY AUDIT 2026-08-21 (V10) — response security headers.
#
# Before this the whole stack set NONE of these, which meant the agent portal
# could be loaded inside an <iframe> on any site in the world. That is
# clickjacking: the attacker's page overlays its own invisible UI on top
# of a logged-in session and harvests clicks that land on real buttons.
#
# ⚠️ THIS FILE HAS TAKEN PRODUCTION DOWN BEFORE (TASK-231) — it went out
# mode 600, LiteSpeed could not read it, and every deep link 404'd. The
# cause was the file's PERMISSIONS, not its contents, and deploy.sh now
# rsyncs with --chmod=D755,F644. Verify after the first deploy that a
# deep link still loads AND that the headers are present:
#     curl -sI https://<host>/login | grep -i 'x-frame\|x-content\|referrer'
#
# Wrapped in IfModule so that a server without mod_headers ignores the
# block instead of throwing a 500 on every request.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# A FULL Content-Security-Policy is deliberately NOT enabled here yet.
#
# A content CSP does not warn when it is wrong — it white-screens the
# app — and the only honest way to tune one is to load every screen in a
# real browser and read the console. That has not been done, so shipping
# one would be trading a clickjacking risk for an outage risk.
#
# The starting point below is believed correct for this app (own bundle,
# API origin, YouTube embeds, blob: for pdf.js workers and object URLs).
# Enable it on a STAGING subdomain first, click through every screen with
# devtools open, then move it into the block above.
#
# Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.partner.syncvision.io; media-src 'self' blob: https://api.partner.syncvision.io; connect-src 'self' https://api.partner.syncvision.io; worker-src 'self' blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
