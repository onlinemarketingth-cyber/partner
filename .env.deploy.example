# ============================================================
# Sync Vision Agent — deploy config
#
# Copy this file to `.env.deploy` (same folder) and fill in your
# real values. `.env.deploy` is gitignored — never commit it, it
# names your real server paths. scripts/deploy.sh reads it.
#
# One-time server setup this assumes is already done by hand once —
# see docs/DEPLOYMENT.md before your first `npm run deploy`.
# ============================================================

# --- Git ---
GIT_REMOTE=origin
GIT_BRANCH=main

# --- SSH connection to Hostinger ---
# hPanel -> Advanced -> SSH Access shows host / port / username.
# Hostinger shared hosting almost never uses port 22 — check yours.
SSH_HOST=your-server.hostinger.com
SSH_PORT=65002
SSH_USER=u123456789

# Leave empty to use your default SSH agent/identity. Set only if
# you use a dedicated deploy key (e.g. ~/.ssh/hostinger_deploy).
SSH_KEY_PATH=

# --- Remote paths (absolute paths on the Hostinger server) ---

# Backend: must already be `git clone`d once by hand (docs/DEPLOYMENT.md
# step 1), with its own backend/.env configured and `composer install`
# already run once. This script only ever does `git fetch` + `reset
# --hard` + `composer install` + `migrate` there — it never re-clones
# and never touches backend/.env.
BACKEND_REMOTE_PATH=/home/u123456789/domains/api.yourdomain.com/backend

# Frontend (Agent Portal) — a plain static-file target (the subdomain's
# document root in hPanel). This script rsyncs the LOCAL frontend/dist/
# build here on every deploy; nothing needs to pre-exist but the folder.
FRONTEND_REMOTE_PATH=/home/u123456789/domains/agent.yourdomain.com/public_html

# Frontend Admin — same idea, its own subdomain.
FRONTEND_ADMIN_REMOTE_PATH=/home/u123456789/domains/admin.yourdomain.com/public_html

# --- Remote binaries ---
# Some shared-hosting plans alias `php`/`composer` to an old/missing
# CLI version. If `ssh ... php -v` isn't 8.3+, point this at the
# versioned binary instead (check what your plan exposes with
# `ssh -p $SSH_PORT $SSH_USER@$SSH_HOST "which php8.3"`).
PHP_BIN=php
COMPOSER_BIN=composer
